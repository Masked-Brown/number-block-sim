# secrets and credentials -- nothing carrying a secret is committable
.env
.env.*
*.key
*.pem
*.token
*.pickle
client_secret*.json
credentials*.json
token*.json
secrets/

# python
__pycache__/
*.pyc
.venv/
venv/

# node
node_modules/
dist/
build/
npm-debug.log*
.npm/

# scratch (kept as a folder, contents ignored; the folder's own rules ride with it)
_tmp/*
!_tmp/.gitkeep
!_tmp/CONTEXT.md

# the assembled prime bundle is ephemeral, regenerated by _prime/src/prime.py;
# a generated bundle must never sit in limbo as an untracked file
_prime/PRIME_bee.md

# test-mode journals are diagnostic scratch, not records
_chronicle/mode-test/

# the deadman's single-writer working state, not records: deadman.last is rewritten
# every cycle; ALARMS.md is the alarm-side counterpart of the sweep's STATUS.md
_orchestration/loop/ALARMS.md
_orchestration/loop/deadman.last

# claude code machine-specific runtime state -- promoted from .git/info/exclude so
# it survives a fresh clone (per-clone local state inside .git/ is never pushed)
**/.claude/*.lock
**/.claude/scheduled_tasks.json
**/.claude/routines/.state/
**/.claude/worktrees/
**/.claude/checkpoints/
**/.claude/mailbox/
**/.claude/agent-registry.json
**/.claude/agent-memory-local
**/.claude/first-run
**/.claude/assistant-daemon-state.json

# os
.DS_Store
Thumbs.db
desktop.ini
